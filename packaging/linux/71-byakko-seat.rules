# Byakko Nia87 configuration collection. Applied before seat ACL processing.
ACTION!="add|change", GOTO="byakko_seat_end"
SUBSYSTEM!="hidraw", GOTO="byakko_seat_end"
ATTRS{idVendor}=="3151", ATTRS{idProduct}=="4011|4015", GOTO="byakko_seat_config"
GOTO="byakko_seat_end"
LABEL="byakko_seat_config"
# Digests of the two exact 20-byte Nia87 configuration descriptors.
PROGRAM=="/usr/bin/sha256sum /sys/class/hidraw/%k/device/report_descriptor", RESULT=="3bf393dfbe6ba9a226539acbfd664a24b23ef1a5046dd904f5794dbb878df511 *|350fea62e225e3d92e9db3bbbd408fcebe386c10405454be661d3d2c3229b0b5 *", TAG+="uaccess"
LABEL="byakko_seat_end"
